queue = []

while True:
    print("\n--- Queue Menu ---")
    print("1. Enqueue")
    print("2. Dequeue")
    print("3. Display")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        value = int(input("Enter value: "))
        queue.append(value)
        print(value, "inserted into queue.")

    elif choice == 2:
        if len(queue) == 0:
            print("Queue is Empty!")
        else:
            removed = queue.pop(0)
            print(removed, "removed from queue.")

    elif choice == 3:
        if len(queue) == 0:
            print("Queue is Empty!")
        else:
            print("Queue elements:", queue)

    elif choice == 4:
        print("Program Ended.")
        break

    else:
        print("Invalid choice!")
